node_modules/
dist/
*.tsbuildinfo
*.log
.DS_Store

# local agent graph data (the user's own store) — not committed
packages/*/.data/
.data/

# durable-store journal home (DurableFsStore default `--store-dir`) — local, not committed
**/.store/
.store/

# local dialogue/session logs (underscore = cross-cutting, per R1) — not committed.
# Unified conversation log: _log/<conversation>/ = trace (pointers); truth flows OUT to tracked homes.
**/_log/
**/_logs/

**/transcripts/*

# ff-brain Postgres secrets (local only, chmod 600)
infra/ff-brain-pg/.env