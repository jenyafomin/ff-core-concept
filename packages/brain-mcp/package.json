{
  "name": "@ff/brain-mcp",
  "version": "0.0.0",
  "type": "module",
  "description": "Thin stdio MCP for the ff-brain service (ADR-0016): tools record · find · read · link. HTTP client only (unix socket + Bearer); identity comes from FF_BRAIN_* env, never from tool args. No dependency on @ff/engine.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ff-brain-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
